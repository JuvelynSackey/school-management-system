PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/school_management?replicaSet=rs0

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

CLIENT_ORIGIN=http://localhost:5173

# Optional — the AI Remark Assistant (JesManage Intelligence) is fully wired
# but silently disabled without this, same as SMTP_* above. Leave blank to
# leave it off; set both to switch it on with no other code changes needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
